rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if owns(uid);

      match /settings/{document=**} {
        allow read, write: if owns(uid);
      }
      match /sessions/{sessionId} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.keys().hasOnly([
            'scenarioId', 'scenarioTitle', 'startedAt', 'durationSeconds', 'summary', 'transcript'
          ]);
      }
      match /savedPhrases/{phraseId} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.keys().hasOnly([
            'phrase', 'translation', 'note', 'createdAt', 'dueAt', 'reviewCount', 'sourceSessionId'
          ]);
      }
    }
  }
}
